generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/landlord"
}

datasource db {
  provider = "mysql"
}

model Estate {
  id                       String  @id @default(uuid())
  name                     String
  noOfUnits                Int
  city                     String
  state                    String
  country                  String
  estateManagerFirstName   String
  estateManagerLastName    String
  estateManagerEmail       String
  estatePhoneNumber        String?
  estateManagerPhoneNumber String?
  address                  String
  estateCode               String  @unique
  roleId                   String

  dbName                   String
  dbUrl                    String 

  status                   EstateStatus @default(ACTIVE)

  memberships              EstateMembership[]
  joinRequests             EstateJoinRequest[]
  subscriptions            Subscription[]
  transactions             Transaction[]
  billings                 Billing[]
  role                     PlatformAdminRole[]

  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
}

model PlatformAdmin {
  id              String  @id @default(uuid())
  email           String  @unique
  password        String
  firstName       String
  lastName        String
  phoneNumber     String?

  isActive        Boolean @default(true)
  isDeleted       Boolean @default(false)

  roles           PlatformAdminRole[]
  auditLogs       PlatformAuditLog[]

  passwordResets  PlatformAdminPasswordReset[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  

  transactions Transaction[]
}

model PlatformAdminPasswordReset {
  id              String   @id @default(uuid())
  adminId         String
  token           String   @unique
  expires_at      DateTime

  isDeleted       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  admin           PlatformAdmin @relation(fields: [adminId], references: [id])
}

model PlatformAdminRole {
  id              String  @id @default(uuid())
  name            String
  permissions     Json
  isDeleted       Boolean @default(false)


  Admin           PlatformAdmin[]
  estate          Estate[]
}

model MobileUserAccount {
  id              String @id @default(uuid())
  email           String @unique
  password        String

  firstName       String?
  lastName        String?
  phoneNumber     String?

  isVerified      Boolean @default(false)
  isActive        Boolean @default(true)
  isDeleted       Boolean @default(false)

  memberships     EstateMembership[]
  joinRequests    EstateJoinRequest[]
  passwordResets  UserPasswordReset[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
}

model Registration {
  id            String    @id @default(uuid())
  email         String    @unique
  otpHash       String
  expiresAt     DateTime
  verifiedAt    DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model UserPasswordReset {
  id            String    @id @default(uuid())
  userId        String
  resetToken    String    @unique
  expiresAt     DateTime
  usedAt        DateTime?

  user          MobileUserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())

  @@index([userId])
}

model EstateMembership {
  id          String @id @default(uuid())
  userId      String
  estateId    String

  status      MembershipStatus @default(ACTIVE)

  user        MobileUserAccount @relation(fields: [userId], references: [id])
  estate      Estate            @relation(fields: [estateId], references: [id])

  joinedAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, estateId])
}

model EstateJoinRequest {
  id          String @id @default(uuid())
  userId      String
  estateId    String

  notes       String?

  status      JoinRequestStatus @default(PENDING)

  reviewedAt  DateTime?
  reviewedBy  String?

  user        MobileUserAccount @relation(fields: [userId], references: [id])
  estate      Estate            @relation(fields: [estateId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, estateId])
}

model Package {
  id                        String  @id @default(uuid())
  name                      String  @unique
  description               String?

  price                     Decimal      @db.Decimal(10, 2)
  billingCycle              BillingCycle

  isActive                  Boolean @default(true)
  isDeleted                 Boolean @default(false)

  subscriptions             Subscription[]
  features                  PackageFeature[]

  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

model PackageFeature {
  id                        String @id @default(uuid())
  packageId                 String

  name                      String
  description               String?
  value                     Json?

  package                   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  createdAt                 DateTime @default(now())

  @@index([packageId])
}

model Subscription {
  id                        String @id @default(uuid())

  estateId                  String
  packageId                 String

  status                    SubscriptionStatus @default(PENDING)

  startDate                 DateTime
  endDate                   DateTime

  amountPaid                Decimal @db.Decimal(10, 2)

  paymentReference          String? @unique
  gateway                   String?

  estate                    Estate  @relation(fields: [estateId], references: [id])
  package                   Package @relation(fields: [packageId], references: [id])
  billings                  Billing[]

  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt  
  

  @@index([estateId])
  @@index([packageId])
}

model Transaction {
  id          String  @id @default(uuid())
  estateId    String?
  adminId     String?

  type        TransactionType
  amount      Decimal         @db.Decimal(10, 2)

  reference   String? @unique

  status      TransactionStatus @default(PENDING)

  gateway     String?
  metadata    Json?

  estate      Estate? @relation(fields: [estateId], references: [id])
  admin       PlatformAdmin? @relation(fields: [adminId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([estateId])
  @@index([createdAt])
}

model Billing {
  id                String @id @default(uuid())
  invoiceNumber     String @unique

  estateId          String
  subscriptionId    String

  amount            Decimal @db.Decimal(10, 2)

  status            BillingStatus @default(PENDING)

  dueDate           DateTime?
  paidAt            DateTime?

  reminderSentAt    DateTime?

  estate            Estate       @relation(fields: [estateId], references: [id])
  subscription      Subscription @relation(fields: [subscriptionId], references: [id])

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([estateId])
}

model PlatformAuditLog {
  id              String   @id @default(uuid())
  action          String
  timestamp       DateTime
  ipAddress       String?
  adminId         String
  email           String?
  roleId          String?
 

  admin           PlatformAdmin? @relation(fields: [adminId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([adminId])
  @@index([createdAt])
}


model EmailTemplate {
  id                String @id @default(uuid())
  name              String @unique
  subject           String
  body              String

  status            EmailTemplateStatus @default(ENABLED)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// model Settings {
// }

enum EmailTemplateStatus {
  ENABLED
  DISABLED
}

enum BillingStatus {
  PENDING
  PAID
  FAILED
}

enum TransactionStatus {
  PENDING
  FAILED
  SUCCESSFUL
}

enum TransactionType {
  RENT
  UTILITY
  SUBSCRIPTION_FEE
  REFUND
  SERVICE_CHARGE
}

enum EstateStatus {
  ACTIVE
  PENDING
  SUSPENDED
  INACTIVE
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  LEFT
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
}
