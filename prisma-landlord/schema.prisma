generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/landlord"
}

datasource db {
  provider = "mysql"
}

model User {
  id           String  @id @default(uuid())
  fullName     String
  email        String? @unique
  phoneNumber  String? @unique
  password     String
  profileImage String?
  occupation   String?
  homeAddress  String?

  isVerified Boolean @default(false)
  isActive   Boolean @default(true)
  isDeleted  Boolean @default(false)

  memberships    EstateMembership[]
  joinRequests   EstateJoinRequest[]
  passwordResets UserPasswordReset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]
}

model UserPasswordReset {
  id         String   @id @default(uuid())
  userId     String
  expiresAt  DateTime
  resetToken String

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Registration {
  id         String    @id @default(uuid())
  email      String    @unique
  otpHash    String
  expiresAt  DateTime
  verifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Estate {
  id                       String @id @default(uuid())
  name                     String
  noOfUnits                Int
  city                     String
  state                    String
  country                  String
  estateManagerEmail       String
  estatePhoneNumber        Int?
  estateManagerPhoneNumber Int?
  address                  String
  estateCode               String @unique

  dbName String
  dbUrl  String

  status EstateStatus @default(ACTIVE)

  memberships  EstateMembership[]
  joinRequests EstateJoinRequest[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]

  transactions Transaction[]
  billings     Billing[]
}

model Package {
  id           String       @id @default(uuid())
  name         String
  description  String?
  price        Int
  billingCycle BillingCycle

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscription {
  id               String             @id @default(uuid())
  estateCode       String
  packageId        String
  status           SubscriptionStatus @default(ACTIVE)
  startDate        DateTime
  endDate          DateTime
  paymentReference String             @unique
  amountPaid       Decimal            @db.Decimal(10, 2)
  gateway          String             @default("paystack")

  package Package @relation(fields: [packageId], references: [id])
  estate  Estate  @relation(fields: [estateCode], references: [estateCode])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EstateMembership {
  id       String           @id @default(uuid())
  userId   String
  estateId String
  status   MembershipStatus @default(ACTIVE)

  user   User   @relation(fields: [userId], references: [id])
  estate Estate @relation(fields: [estateId], references: [id])

  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, estateId])
}

model EstateJoinRequest {
  id       String            @id @default(uuid())
  estateId String
  notes    String?
  status   JoinRequestStatus @default(PENDING)

  reviewedAt DateTime?
  reviewedBy String?

  estate Estate @relation(fields: [estateId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?

  @@unique([estateId])
}

model Admin {
  id          String  @id @default(uuid())
  email       String  @unique
  password    String
  firstName   String?
  lastName    String?
  phoneNumber String?

  roleId String

  isDeleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  adminPasswordReset AdminPasswordReset[]
  auditLogs          AuditLog[]

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  transactions       Transaction[]
  emailNotifications EmailNotification[]
}

model AdminPasswordReset {
  id         String   @id @default(uuid())
  admin_id   String
  token      String   @unique
  expires_at DateTime

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admin Admin @relation(fields: [admin_id], references: [id])
}

model Role {
  id          String  @id @default(uuid())
  name        String
  permissions Json
  isDeleted   Boolean @default(false)

  Admin Admin[]
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  timestamp DateTime
  ipAddress String
  adminId   String
  email     String?
  roleId    String?

  userId String
  admin  Admin? @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Transaction {
  id       String            @id @default(uuid())
  type     TransactionType
  amount   Decimal           @db.Decimal(10, 2)
  userId   String
  adminId  String
  estateId String
  status   TransactionStatus @default(PENDING)

  user   User?   @relation(fields: [userId], references: [id])
  admin  Admin?  @relation(fields: [adminId], references: [id])
  estate Estate? @relation(fields: [estateId], references: [estateCode])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Billing {
  id             String  @id @default(uuid())
  invoiceId      String
  estateId       String
  subscriptionId String
  amount         Decimal @db.Decimal(10, 2)

  status BillingStatus @default(PENDING)
  estate Estate        @relation(fields: [estateId], references: [estateCode])

  //reminder

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmailNotification {
  id          String      @id @default(uuid())
  name        String
  subject     String
  emailStatus emailStatus

  adminId String
  email   String?
  roleId  String?

  userId String?
  admin  Admin?  @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Settings {
}

enum emailStatus {
  ENABLED
  DISABLED
}

enum BillingStatus {
  PENDING
  PAID
  FAILED
}

enum TransactionStatus {
  PENDING
  FAILED
  SUCCESSFUL
}

enum TransactionType {
  RENT
  UTILITY
  SUBSCRIPTION
  REFUND
  SERVICE_CHARGE
}

enum EstateStatus {
  ACTIVE
  PENDING
  SUSPENDED
  INACTIVE
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  LEFT
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
}
