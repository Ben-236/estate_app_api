generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/tenant"
}

datasource db {
  provider = "mysql"
}

model Member {
  id           String @id @default(uuid())
  globalUserId String

  firstName    String?
  lastName     String?
  phoneNumber  String?
  occupation   String?
  profileImage String?

  status MemberStatus @default(ACTIVE)

  roles MemberRole[]

  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  maintenanceRequests    MaintenanceRequest[]
  propertyOwners         PropertyOwner[]
  propertyResidents      PropertyResident[]
  invoices               Invoice[]
  payments               Payment[]
  notifications          Notification[]
  notificationPreference NotificationPreference?

  @@unique([globalUserId])
}

model Guest {
  id          String  @id @default(uuid())
  fullName    String
  email       String?
  phoneNumber String

  numberOfVisitor Int?
  description     String?

  checkInDate  DateTime?
  checkOutDate DateTime?

  checkInTime  DateTime?
  checkOutTime DateTime?

  guestCode Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Staff {
  id          String  @id @default(uuid())
  fullName    String
  email       String?
  phoneNumber String?

  numberOfVisitors Int?
  description      String?

  checkInDate  DateTime?
  checkOutDate DateTime?

  checkInTime  DateTime?
  checkOutTime DateTime?

  staffCode   Int?
  allowedDays DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id          String @id @default(uuid())
  name        String @unique
  permissions Json?

  isDeleted Boolean @default(false)

  members MemberRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}



model MemberRole {
  id       String @id @default(uuid())
  memberId String
  roleId   String

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([memberId, roleId])
}


model Maintainer {
  id             String         @id @default(uuid())
  firstName      String
  lastName       String
  email          String
  phoneNumber    String
  password       String
  property       String
  maintainerType maintainerType
  profileImage   String?

  maintenance MaintenanceRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Security {
  id String @id @default(uuid())
}

model MaintenanceRequest {
  id String @id @default(uuid())

  propertyId   String?
  unitId       String?
  maintainerId String?

  requestedByMemberId String?

  requestDate String

  issue_type MaintenanceIssueType
  status     MaintenanceStatus

  issueAttachment String?
  note            String?

  property   Property?   @relation(fields: [propertyId], references: [id])
  unit       Unit?       @relation(fields: [unitId], references: [id])
  maintainer Maintainer? @relation(fields: [maintainerId], references: [id])

  requestedBy Member? @relation(fields: [requestedByMemberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Property {
  id              String @id @default(uuid())
  name            String
  propertyType    PropertyType

  address         String?
  city            String?
  state           String?
  country         String?
  zipCode         String?

  description     String?
  thumbnailImage  String?
  propertyImage   String?

  units           Unit[]

  owners          PropertyOwner[]
  residents       PropertyResident[]

  maintenanceRequests MaintenanceRequest[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Unit {
  id            String @id @default(uuid())
  propertyId    String
  name          String

  bedrooms      Int?
  kitchens      Int?
  bathrooms     Int?

  rentType      RentType

  rentAmount    Decimal? @db.Decimal(10, 2)
  rentDuration  Int?

  depositType   DepositType
  depositAmount Decimal?    @db.Decimal(10, 2)

  lateFeeType   LateFeeType
  lateFeeAmount Decimal?    @db.Decimal(10, 2)

  incidentReceiptAmount Decimal? @db.Decimal(10, 2)

  notes         String?

  property            Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  maintenanceRequests MaintenanceRequest[]
  invoices            Invoice[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
}

model RepairRequest {
  id            String              @id @default(uuid())
  requestDate   DateTime?
  issueType     RepairIssueType
  maintainer    String?
  status        RepairRequestStatus @default(PENDING)

  issueDocument String?
  notes         String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Invoice {
  id            String @id @default(uuid())

  invoiceNumber String @unique

  memberId      String
  unitId        String?

  type          InvoiceType

  amount        Decimal @db.Decimal(10, 2)

  status        InvoiceStatus @default(PENDING)

  dueDate       DateTime?
  paidAt        DateTime?

  description   String?

  member        Member @relation(fields: [memberId], references: [id])
  unit          Unit?  @relation(fields: [unitId], references: [id])

  payments      Payment[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Payment {
  id            String @id @default(uuid())
  invoiceId     String
  memberId      String

  amount        Decimal @db.Decimal(10, 2)

  reference     String  @unique
  gateway       String?

  status        PaymentStatus @default(PENDING)

  invoice       Invoice       @relation(fields: [invoiceId], references: [id])
  member        Member  @relation(fields: [memberId], references: [id])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Notification {
  id            String @id @default(uuid())
  memberId      String
  title         String
  message       String

  type          NotificationType

  isRead        Boolean   @default(false)
  readAt        DateTime?

  createdAt     DateTime @default(now())

  member        Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, isRead])
}

model NotificationPreference {
  id          String @id @default(uuid())
  memberId    String @unique

  emailEnabled Boolean @default(true)
  pushEnabled  Boolean @default(true)

  member      Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EstateRule {
  id          String @id @default(uuid())
  title       String
  description String?

  documentUrl String?

  isActive    Boolean @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PropertyOwner {
  id          String @id @default(uuid())
  propertyId  String
  memberId    String

  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@unique([propertyId, memberId])
}

model PropertyResident {
  id          String @id @default(uuid())
  propertyId  String
  memberId    String

  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@unique([propertyId, memberId])
}

