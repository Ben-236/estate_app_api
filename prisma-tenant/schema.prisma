enum RepairRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum RepairIssueType {
  CLEANING
  REPAIR
  OTHER
}

enum maintainerType {
  PLUMBER
  ELECTRICITY
  CLEANING
  OTHER
}

enum MemberStatus {
  ACTIVE
  SUSPENDED
  LEFT
}

enum MaintenanceStatus {
  IN_PROGRESS
  PENDING
  COMPLETED
}

enum NotificationType {
  EMAIL
  PUSH
}

enum PaymentStatus {
  PAID
  PENDING
  FAILED
}

enum InvoiceStatus {
  PENDING
  PAID
  FAILED
}

enum MaintenanceIssueType {
  CLEANING
  REPAIR
  OTHER
}

enum InvoiceType {
  HOUSE
  APARTMENT
  OTHER
}

enum PropertyType {
  APARTMENT
  HOUSE
  OTHER
}

enum RentType {
  MONTHLY
  ANNUAL
  OTHER
}

enum DepositType {
  BANK
  OTHER
}

enum LateFeeType {
  PER_DAY
  PER_MONTH
  OTHER
}
